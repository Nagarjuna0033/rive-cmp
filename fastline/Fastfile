default_platform(:android)

###############################################################
# SLACK
###############################################################

def notify_slack(message, payload = {})
  slack(
    slack_url: ENV["SLACK_WEBHOOK_URL"],
    success: true,
    message: message,
    payload: payload.merge(
      "Branch" => ENV["CI_COMMIT_REF_NAME"],
      "Commit" => ENV["CI_COMMIT_SHORT_SHA"],
      "Triggered By" => ENV["GITLAB_USER_NAME"]
    )
  )
end

###############################################################
# ANDROID
###############################################################

platform :android do

  desc "Deploy Dev Debug"
  lane :android_dev_debug do

    firebase_app_distribution(
      app: ENV["FIREBASE_ANDROID_APP_ID"],
      android_artifact_path: ENV["ARTIFACT_PATH"],
      groups: ENV["FIREBASE_GROUPS"]
    )

    notify_slack(
      "🚀 Android Dev Debug distributed to Firebase",
      {
        "Variant" => "DevDebug",
        "Firebase Group" => ENV["FIREBASE_GROUPS"]
      }
    )

  end

  desc "Deploy Dev Release"
  lane :android_dev_release do

    firebase_app_distribution(
      app: ENV["FIREBASE_ANDROID_APP_ID"],
      android_artifact_path: ENV["ARTIFACT_PATH"],
      groups: ENV["FIREBASE_GROUPS"]
    )

    notify_slack(
      "🚀 Android Dev Release distributed to Firebase",
      {
        "Variant" => "DevRelease",
        "Firebase Group" => ENV["FIREBASE_GROUPS"]
      }
    )

  end

  desc "Deploy Prod Debug"
  lane :android_prod_debug do

    firebase_app_distribution(
      app: ENV["FIREBASE_ANDROID_APP_ID"],
      android_artifact_path: ENV["ARTIFACT_PATH"],
      groups: ENV["FIREBASE_GROUPS"]
    )

    notify_slack(
      "🚀 Android Prod Debug distributed to Firebase",
      {
        "Variant" => "ProdDebug",
        "Firebase Group" => ENV["FIREBASE_GROUPS"]
      }
    )

  end

  desc "Deploy Prod Release"
  lane :android_prod_release do

    firebase_app_distribution(
      app: ENV["FIREBASE_ANDROID_APP_ID"],
      android_artifact_path: ENV["APK_PATH"],
      groups: ENV["FIREBASE_GROUPS"]
    )

    upload_to_play_store(
      package_name: "com.arjun.app",
      aab: ENV["AAB_PATH"],
      track: "internal",
      json_key: ENV["PLAY_STORE_JSON_PATH"]
    )

    notify_slack(
      "🎉 Android Prod Release uploaded to Firebase & Google Play Internal Testing",
      {
        "Variant" => "ProdRelease",
        "Firebase Group" => ENV["FIREBASE_GROUPS"],
        "Play Track" => "Internal"
      }
    )

  end

end

###############################################################
# IOS
###############################################################

def provisioning_profile_info
  require "plist"

  path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/profile.mobileprovision")
  xml  = `security cms -D -i "#{path}"`
  data = Plist.parse_xml(xml)

  team      = data["TeamIdentifier"].first
  app_id    = data["Entitlements"]["application-identifier"]
  bundle_id = app_id.sub("#{team}.", "")

  { name: data["Name"], team: team, bundle_id: bundle_id }
end

def firebase_ios_app_id
  require "plist"

  data = Plist.parse_xml("ios/GoogleService-Info.plist")
  data["GOOGLE_APP_ID"]
end

platform :ios do

  desc "Development"
  lane :ios_dev do

    profile = provisioning_profile_info
    UI.message("Signing with profile '#{profile[:name]}' (team #{profile[:team]}, bundle #{profile[:bundle_id]})")

    build_ios_app(
      workspace: "ios/iosApp.xcworkspace",
      scheme: "iosApp-Dev",
      configuration: "Dev Debug",
      export_method: "development",
      output_directory: "ios/build",
      output_name: "Dev",
      xcodebuild_formatter: "",
      build_timing_summary: true,
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM='#{profile[:team]}' " \
              "CODE_SIGN_IDENTITY='Apple Development' " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile[:name]}'",
      export_options: {
        signingStyle: "manual",
        teamID: profile[:team],
        provisioningProfiles: {
          profile[:bundle_id] => profile[:name]
        }
      }
    )

    firebase_app_distribution(
      app: firebase_ios_app_id,
      ipa_path: "ios/build/Dev.ipa",
      groups: "Dev-Qa"
    )

    notify_slack(
      "🚀 iOS Dev distributed to Firebase",
      {
        "Scheme" => "iosApp-Dev",
        "Firebase Group" => ENV["FIREBASE_GROUPS"],
      }
    )

  end

